<view class="tab-bar">
  <view class="tab-item" wx:for="{{list}}" wx:key="pagePath" data-index="{{index}}" bindtap="switchTab">
    <text wx:if="{{item.iconText}}" class="tab-symbol {{selected === index ? 'active' : ''}}">{{item.iconText}}</text>
    <image wx:else class="tab-icon" src="{{selected === index ? item.selectedIconPath : item.iconPath}}"></image>
    <text class="tab-text {{selected === index ? 'active' : ''}}">{{item.text}}</text>
  </view>
</view>
