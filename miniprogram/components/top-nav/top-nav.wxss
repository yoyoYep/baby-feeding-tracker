.top-nav {
  background: #fff;
}

.nav-row {
  display: grid;
  grid-template-columns: 128rpx 1fr 128rpx;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.nav-side {
  min-width: 0;
}

.nav-side.right {
  display: flex;
  justify-content: flex-end;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 64rpx;
  color: #2D2F33;
  font-size: 66rpx;
  font-weight: 300;
}

.nav-title {
  min-width: 0;
  text-align: center;
  color: #2D2F33;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.right-btn {
  min-width: 104rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #FF9AA2, #FFB7B2);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
