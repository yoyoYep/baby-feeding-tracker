<top-nav title="记录时间轴" show-back="{{true}}" fallback-url="/pages/more/more" />

<view class="container timeline-page">
  <view class="date-bar card">
    <view class="date-nav prev" bindtap="prevDay">‹</view>
    <view class="date-center">
      <picker mode="date" value="{{dateStr}}" end="{{todayStr}}" bindchange="onDateChange">
        <view class="date-main">
          <text class="date-label">{{dateLabel}}</text>
          <text class="date-str">{{rangeText}}</text>
        </view>
      </picker>
    </view>
    <view class="date-nav next {{isToday ? 'disabled' : ''}}" bindtap="nextDay">›</view>
    <view wx:if="{{!isToday}}" class="today-btn" bindtap="goToday">今天</view>
  </view>

  <view class="summary-strip">
    <view class="summary-chip">
      <text class="summary-value">{{recordCount}}</text>
      <text class="summary-label">记录</text>
    </view>
    <view class="summary-chip">
      <text class="summary-value duration">{{durationCount}}</text>
      <text class="summary-label">时段</text>
    </view>
    <view class="summary-chip">
      <text class="summary-value point">{{pointCount}}</text>
      <text class="summary-label">瞬时</text>
    </view>
  </view>

  <view wx:if="{{loading && daySections.length === 0}}" class="empty-card card">
    <text class="empty-title">加载中</text>
  </view>

  <view wx:elif="{{daySections.length === 0}}" class="empty-card card">
    <text class="empty-title">暂无记录</text>
    <text class="empty-desc">下拉可以继续接上更早的日期。</text>
  </view>

  <view wx:else class="timeline-days">
    <view class="timeline-stream-card card">
      <view class="day-section" wx:for="{{daySections}}" wx:for-item="section" wx:key="dateStr">
        <view wx:if="{{section.recordCount === 0}}" class="day-empty">
          <view class="day-heading">
            <text class="day-label">{{section.dateLabel}}</text>
            <text class="day-date">{{section.dateStr}}</text>
            <text class="day-count">{{section.recordCount}}条</text>
          </view>
          <text>这一天没有记录</text>
        </view>

        <view wx:else class="axis-shell" style="height: {{section.dayHeightRpx}}rpx;">
          <view class="day-heading">
            <text class="day-label">{{section.dateLabel}}</text>
            <text class="day-date">{{section.dateStr}}</text>
            <text class="day-count">{{section.recordCount}}条</text>
          </view>

          <view class="hour-row" wx:for="{{section.hourMarks}}" wx:for-item="mark" wx:key="hour" style="top: {{mark.topRpx}}rpx;">
            <text class="hour-label">{{mark.label}}</text>
            <view class="hour-rule"></view>
          </view>

          <view class="axis-content">
            <view wx:if="{{section.showNowMarker}}" class="now-marker" style="top: {{section.nowTopRpx}}rpx;">
              <view class="now-rule"></view>
              <text class="now-label">现在</text>
            </view>

            <view class="duration-track">
              <view
                class="time-block {{item.typeClass}}"
                wx:for="{{section.durationItems}}"
                wx:key="_id"
                data-id="{{item._id}}"
                bindtap="showRecordDetail"
                style="top: {{item.topRpx}}rpx; height: {{item.heightRpx}}rpx; left: {{item.laneLeftPct}}%; width: calc({{item.laneWidthPct}}% - 8rpx);">
                <view class="block-head">
                  <text class="block-icon">{{item.icon}}</text>
                  <text class="block-text">{{item.displayText}}</text>
                </view>
                <view class="block-foot" wx:if="{{item.edgeText}}">
                  <text wx:if="{{item.edgeText}}">{{item.edgeText}}</text>
                </view>
              </view>
            </view>

            <view class="point-track">
              <view
                class="point-item {{item.typeClass}}"
                wx:for="{{section.pointItems}}"
                wx:key="_id"
                data-id="{{item._id}}"
                bindtap="showRecordDetail"
                style="top: {{item.topRpx}}rpx; left: {{item.staggerX}}rpx;">
                <view class="point-dot">{{item.icon}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="load-more-tip">
      <text>{{loading ? '加载中' : '下拉或滑到底部继续加载更早日期'}}</text>
    </view>
  </view>
</view>

<view wx:if="{{showDetail}}" class="detail-mask" bindtap="closeRecordDetail">
  <view class="detail-dialog" catchtap="">
    <view class="detail-header">
      <view class="detail-title-row">
        <text class="detail-icon">{{detailRecord.icon}}</text>
        <text class="detail-title">{{detailRecord.detailTitle}}</text>
      </view>
      <text class="detail-close" bindtap="closeRecordDetail">×</text>
    </view>
    <text class="detail-time">{{detailRecord.detailTime}}</text>
    <view class="detail-lines" wx:if="{{detailRecord.detailLines && detailRecord.detailLines.length}}">
      <view class="detail-line" wx:for="{{detailRecord.detailLines}}" wx:key="label">
        <text class="detail-line-label">{{item.label}}</text>
        <text class="detail-line-value">{{item.value}}</text>
      </view>
    </view>
    <view wx:else class="detail-empty">暂无更多信息</view>
  </view>
</view>
