/* 底部操作区 */
.bottom-bar {
  position: fixed;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  gap: 20rpx;
  z-index: 90;
}

.bottom-add {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9AA2, #FFB7B2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 154, 162, 0.4);
}

.bottom-add text {
  color: #fff;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

.bottom-voice {
  flex: 1;
}

/* 进行中卡片 */
.ongoing-card {
  display: flex;
  align-items: center;
  border-left: 6rpx solid;
}

.feeding-ongoing { border-color: #42A5F5; }
.sleep-ongoing { border-color: #AB47BC; }

.delayed-feeding-card {
  display: flex;
  align-items: center;
  border-left: 6rpx solid #FF9AA2;
  background: linear-gradient(90deg, #FFF8F8 0%, #fff 70%);
}

.delayed-icon {
  width: 58rpx;
  height: 58rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: #FFF0F1;
  color: #FF9AA2;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ongoing-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.ongoing-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ongoing-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #222;
}

.ongoing-time {
  font-size: 26rpx;
  color: #666;
  margin-top: 4rpx;
}

.ongoing-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.ongoing-action {
  font-size: 28rpx;
  color: #FF9AA2;
  padding: 10rpx 24rpx;
  border: 1rpx solid #FF9AA2;
  border-radius: 30rpx;
}

.ongoing-action.secondary {
  color: #999;
  border-color: #e5e5e5;
  background: #fafafa;
}

/* 统计卡片 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 16rpx;
  text-align: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.stat-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #222;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.quick-start-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 18rpx;
}

.quick-start-btn {
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #FFF8F8;
  border: 1rpx solid #FFE2E5;
}

.quick-start-btn.active {
  background: #fff;
  border-color: #FF9AA2;
  box-shadow: 0 4rpx 14rpx rgba(255, 154, 162, 0.16);
}

.quick-start-btn.pending {
  border-color: #FF9AA2;
  background: #fff;
}

.quick-start-icon {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #fff;
  font-size: 32rpx;
}

.quick-start-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.quick-start-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.25;
}

.quick-start-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.2;
}

.quick-start-btn.active .quick-start-title {
  color: #FF9AA2;
}

.quick-start-btn.sleep {
  background: #FCF8FF;
  border-color: #F0E4F8;
}

.quick-start-btn.sleep.active {
  background: #fff;
  border-color: #D8B9E8;
  box-shadow: 0 4rpx 14rpx rgba(171, 71, 188, 0.12);
}

.quick-start-btn.sleep.active .quick-start-title {
  color: #AB47BC;
}

.feeding-info {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}

.feeding-info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.feeding-info-label {
  font-size: 26rpx;
  color: #666;
}

.feeding-info-value {
  font-size: 30rpx;
  font-weight: 600;
}

.feeding-info-value.normal {
  color: #4CAF50;
}

.feeding-info-value.overdue {
  color: #E53935;
}

/* 时间线 */
.date-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  gap: 30rpx;
}

.date-arrow {
  font-size: 44rpx;
  color: #FF9AA2;
  padding: 10rpx 20rpx;
  font-weight: bold;
}

.date-arrow.disabled {
  color: #ddd;
}

.date-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  padding: 8rpx 20rpx;
}

.back-today {
  font-size: 26rpx;
  color: #FF9AA2;
  border: 1rpx solid #FF9AA2;
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
}

.record-count {
  font-size: 26rpx;
  color: #999;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 快捷操作 */
.action-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 200rpx;
}

.action-sheet {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 30rpx;
  background: #fff;
  padding: 40rpx 50rpx;
  border-radius: 24rpx;
  max-width: 640rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.feeding-icon { background: #BBDEFB; }
.diaper-icon { background: #FFE0B2; }
.sleep-icon { background: #E1BEE7; }
.bath-icon { background: #D6EEF8; }
.supplement-icon { background: #C8E6C9; }
.health-icon { background: #FFCDD2; }
.growth-icon { background: #C8E6C9; }

.action-item text {
  font-size: 26rpx;
  color: #444;
}

/* 身高体重弹窗 */
.growth-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.growth-mask-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.growth-dialog {
  position: relative;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 80%;
  z-index: 1;
}

.growth-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 30rpx;
}

.growth-form-item {
  margin-bottom: 24rpx;
}

.growth-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.growth-input {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.growth-save-btn {
  margin-top: 30rpx;
  width: 100% !important;
}

.growth-delete-btn {
  margin-top: 16rpx;
  width: 100% !important;
  background: #fff !important;
  color: #FF4D4F !important;
  border: 2rpx solid #FF4D4F !important;
  border-radius: 50rpx !important;
}

/* 健康编辑标签 */
.health-tags {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.health-tag {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: #666;
}

.health-tag.active {
  background: #FFF5F5;
  color: #FF9AA2;
  border: 1rpx solid #FF9AA2;
}
