/* 底部操作区 */
.container {
  padding: 16rpx 22rpx;
  padding-bottom: 300rpx;
}

.card {
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(25, 30, 40, 0.05);
}

.bottom-bar {
  position: fixed;
  bottom: calc(108rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  gap: 20rpx;
  z-index: 90;
}

.bottom-add {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9AA2, #FFB7B2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 154, 162, 0.4);
}

.bottom-add text {
  color: #fff;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

.bottom-voice {
  flex: 1;
}

.success-notice {
  position: fixed;
  left: 36rpx;
  right: 36rpx;
  top: calc(120rpx + env(safe-area-inset-top));
  z-index: 1200;
  min-height: 86rpx;
  padding: 18rpx 26rpx;
  border-radius: 18rpx;
  background: #1F8F4D;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 30rpx rgba(31, 143, 77, 0.28);
}

.success-mark {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-date-card {
  padding: 20rpx 22rpx;
}

/* 进行中卡片 */
.ongoing-card {
  display: flex;
  align-items: center;
  border-left: 6rpx solid;
  padding: 18rpx 20rpx;
  min-height: 72rpx;
}

.feeding-ongoing { border-color: #42A5F5; }
.sleep-ongoing { border-color: #AB47BC; }

.delayed-feeding-card {
  display: flex;
  align-items: center;
  border-left: 6rpx solid #FF9AA2;
  background: linear-gradient(90deg, #FFF8F8 0%, #fff 70%);
}

.delayed-icon {
  width: 58rpx;
  height: 58rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: #FFF0F1;
  color: #FF9AA2;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ongoing-icon {
  font-size: 38rpx;
  margin-right: 18rpx;
}

.ongoing-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ongoing-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #222;
  line-height: 1.25;
}

.ongoing-time {
  font-size: 27rpx;
  color: #666;
  margin-top: 4rpx;
  line-height: 1.25;
}

.ongoing-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.ongoing-action {
  font-size: 28rpx;
  color: #FF9AA2;
  padding: 8rpx 20rpx;
  border: 1rpx solid #FF9AA2;
  border-radius: 999rpx;
  line-height: 1.25;
}

.ongoing-action.secondary {
  color: #999;
  border-color: #e5e5e5;
  background: #fafafa;
}

/* 统计卡片 */
.stats-card {
  padding: 22rpx 24rpx 20rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 10rpx;
  text-align: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}

.stat-icon {
  font-size: 44rpx;
  margin-bottom: 4rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #222;
  line-height: 1.12;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.diaper-stat-pair {
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.diaper-stat-mini {
  display: flex;
  align-items: baseline;
  gap: 3rpx;
}

.diaper-stat-num {
  font-size: 38rpx;
  line-height: 1.1;
  font-weight: 800;
}

.diaper-stat-mini.pee .diaper-stat-num {
  color: #2A95A3;
}

.diaper-stat-mini.poop .diaper-stat-num {
  color: #B77900;
}

.diaper-stat-label {
  font-size: 24rpx;
  color: #8D99A6;
}

.quick-start-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.quick-start-btn {
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 13rpx 16rpx;
  border-radius: 14rpx;
  background: #FFF1F2;
  border: 2rpx solid #FF9AA2;
  box-shadow: 0 6rpx 16rpx rgba(255, 154, 162, 0.16);
}

.quick-start-btn.active {
  background: #fff;
  border-color: #F06F7B;
  box-shadow: 0 6rpx 18rpx rgba(255, 154, 162, 0.24);
}

.quick-start-btn.pending {
  border-color: #FF9AA2;
  background: #fff;
}

.quick-start-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #fff;
  font-size: 42rpx;
  line-height: 1;
  box-shadow: inset 0 0 0 2rpx rgba(255, 154, 162, 0.24);
}

.quick-start-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.quick-start-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #E8505B;
  line-height: 1.25;
}

.quick-start-desc {
  margin-top: 2rpx;
  font-size: 25rpx;
  color: #A85C62;
  line-height: 1.2;
}

.quick-start-btn.active .quick-start-title {
  color: #FF9AA2;
}

.quick-start-btn.sleep {
  background: #F5EDFF;
  border-color: #AB47BC;
  box-shadow: 0 6rpx 16rpx rgba(171, 71, 188, 0.14);
}

.quick-start-btn.sleep.active {
  background: #fff;
  border-color: #8E35A0;
  box-shadow: 0 6rpx 18rpx rgba(171, 71, 188, 0.2);
}

.quick-start-btn.sleep.active .quick-start-title {
  color: #AB47BC;
}

.quick-start-btn.sleep .quick-start-icon {
  box-shadow: inset 0 0 0 2rpx rgba(171, 71, 188, 0.22);
}

.quick-start-btn.sleep .quick-start-title {
  color: #8E35A0;
}

.quick-start-btn.sleep .quick-start-desc {
  color: #75517E;
}

.feeding-info {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
}

.feeding-info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.feeding-info-label {
  font-size: 26rpx;
  color: #666;
}

.feeding-info-value {
  font-size: 31rpx;
  font-weight: 600;
}

.feeding-info-value.normal {
  color: #4CAF50;
}

.feeding-info-value.overdue {
  color: #E53935;
}

.care-facts-line {
  margin-top: 12rpx;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  background: #F7FBFF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.care-facts-label {
  flex-shrink: 0;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: #EAF4FF;
  color: #4E85B6;
  font-size: 24rpx;
  line-height: 1.25;
}

.care-facts-text {
  min-width: 0;
  color: #617386;
  font-size: 26rpx;
  line-height: 1.4;
}

.feeding-plan-card {
  padding: 22rpx 22rpx 20rpx;
  border-left: 6rpx solid #42A5F5;
  background: linear-gradient(135deg, #FFFFFF 0%, #F7FBFF 100%);
}

.feeding-plan-card.due {
  border-left-color: #E8505B;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF7F7 100%);
}

.feeding-plan-card.sleeping {
  border-left-color: #8E35A0;
  background: linear-gradient(135deg, #FFFFFF 0%, #FBF7FF 100%);
}

.feeding-plan-card.done {
  border-left-color: #1F8F4D;
  background: linear-gradient(135deg, #FFFFFF 0%, #F3FFF7 100%);
}

.feeding-plan-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  min-width: 0;
}

.feeding-plan-leading {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
}

.feeding-plan-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: #EAF5FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 2rpx rgba(66, 165, 245, 0.12);
}

.feeding-plan-card.due .feeding-plan-icon {
  background: #FFEDEE;
  box-shadow: inset 0 0 0 2rpx rgba(232, 80, 91, 0.12);
}

.feeding-plan-card.sleeping .feeding-plan-icon {
  background: #F0E4FA;
  box-shadow: inset 0 0 0 2rpx rgba(142, 53, 160, 0.12);
}

.feeding-plan-card.done .feeding-plan-icon {
  background: #E5F7EC;
  box-shadow: inset 0 0 0 2rpx rgba(31, 143, 77, 0.12);
}

.feeding-plan-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.feeding-plan-title {
  max-width: 100%;
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.feeding-plan-sub {
  margin-top: 6rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #2E83C5;
  line-height: 1.12;
}

.feeding-plan-card.due .feeding-plan-sub {
  color: #E8505B;
}

.feeding-plan-card.sleeping .feeding-plan-sub {
  color: #8E35A0;
}

.feeding-plan-card.done .feeding-plan-sub {
  color: #1F8F4D;
}

.feeding-plan-estimate {
  margin-top: 14rpx;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(247, 250, 253, 0.88);
  border: 1rpx solid #E6EEF6;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-sizing: border-box;
}

.feeding-plan-estimate-label {
  flex-shrink: 0;
  font-size: 25rpx;
  color: #8795A6;
  line-height: 1.2;
}

.feeding-plan-estimate-time {
  min-width: 0;
  font-size: 36rpx;
  font-weight: 800;
  color: #2E83C5;
  line-height: 1.15;
}

.feeding-plan-card.sleeping .feeding-plan-estimate {
  background: #FBF7FF;
  border-color: #EADDF5;
}

.feeding-plan-card.sleeping .feeding-plan-estimate-time {
  color: #8E35A0;
}

.feeding-plan-card.due .feeding-plan-estimate {
  background: #FFF7F7;
  border-color: #FFE0E2;
}

.feeding-plan-card.due .feeding-plan-estimate-time {
  color: #E8505B;
}

.feeding-plan-card.done .feeding-plan-estimate {
  background: rgba(244, 253, 247, 0.9);
  border-color: #D4EEDD;
}

.feeding-plan-card.done .feeding-plan-estimate-time {
  color: #1F8F4D;
}

.feeding-plan-count {
  min-width: 108rpx;
  height: 70rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(246, 250, 255, 0.95);
  border: 1rpx solid #E3EEF8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feeding-plan-count-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #2E83C5;
  line-height: 1.1;
}

.feeding-plan-count-label {
  margin-top: 2rpx;
  font-size: 24rpx;
  color: #8A9BAD;
}

.feeding-plan-card.due .feeding-plan-count {
  background: #FFF7F7;
  border-color: #FFE0E2;
}

.feeding-plan-card.due .feeding-plan-count-num {
  color: #E8505B;
}

.feeding-plan-card.sleeping .feeding-plan-count {
  background: #FBF7FF;
  border-color: #EADDF5;
}

.feeding-plan-card.sleeping .feeding-plan-count-num {
  color: #8E35A0;
}

.feeding-plan-card.done .feeding-plan-count {
  background: #F4FDF7;
  border-color: #D4EEDD;
}

.feeding-plan-card.done .feeding-plan-count-num {
  color: #1F8F4D;
}

.feeding-plan-meta {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.feeding-plan-meta text {
  max-width: 100%;
  padding: 7rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(245, 247, 250, 0.9);
  color: #66717D;
  font-size: 25rpx;
  line-height: 1.25;
}

.feeding-plan-snooze {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 7rpx 12rpx;
  border-radius: 8rpx;
  background: #FFF7E6;
  color: #B35A00;
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 700;
}

.feeding-plan-scroll {
  margin-top: 12rpx;
  width: 100%;
  white-space: nowrap;
}

.feeding-plan-times {
  display: inline-flex;
  gap: 10rpx;
  padding-bottom: 2rpx;
}

.feeding-plan-pill {
  height: 56rpx;
  min-width: 110rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: rgba(247, 248, 250, 0.94);
  color: #8B96A3;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  box-sizing: border-box;
  border: 1rpx solid #EDF0F3;
}

.feeding-plan-pill.done {
  background: #EFFAF3;
  color: #1F8F4D;
  border-color: #CDEED9;
}

.feeding-plan-pill.current {
  background: #FFF3F4;
  color: #E8505B;
  border-color: #FFD5D9;
}

.feeding-plan-pill.next {
  background: #EAF5FF;
  color: #2E83C5;
  border-color: #B9DDF8;
  font-weight: 700;
}

.feeding-plan-pill-time {
  font-size: 26rpx;
  line-height: 1;
}

.feeding-plan-pill-mark {
  font-size: 24rpx;
  line-height: 1;
}

.feeding-plan-warning {
  margin-top: 12rpx;
  color: #D46B08;
  background: #FFF7E6;
  border-radius: 8rpx;
  padding: 10rpx 14rpx;
  font-size: 25rpx;
}

.care-suggestion-card {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #E8F4FD;
}

.ai-assistant-content {
  background: #F0F9FF;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
}
.ai-assistant-header {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}
.ai-assistant-icon {
  font-size: 30rpx;
  line-height: 1.35;
}
.ai-assistant-title {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.ai-assistant-status {
  font-size: 29rpx;
  color: #1A1A1A;
  font-weight: 500;
  line-height: 1.35;
}
.ai-assistant-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.ai-assistant-voice {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #E3F2FD;
  color: #2E83C5;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.ai-assistant-voice.playing {
  background: #FFF3F4;
  color: #E8505B;
  font-size: 24rpx;
}
.ai-assistant-voice.loading {
  color: #8795A6;
}
.ai-assistant-refresh {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #F4F7FA;
  color: #7D8A99;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.ai-assistant-suggestions {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.ai-assistant-suggestion {
  font-size: 27rpx;
  color: #333;
  line-height: 1.45;
}
.ai-assistant-reason {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #999;
}
.ai-assistant-loading {
  padding: 14rpx 16rpx;
  background: #F0F9FF;
  border-radius: 12rpx;
  text-align: center;
}
.ai-assistant-loading-text {
  font-size: 27rpx;
  color: #999;
}

.early-education-content {
  padding: 12rpx 14rpx;
  background: #F4FBF7;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.early-education-content.with-ai {
  margin-top: 10rpx;
}

.early-education-topline {
  width: 86rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 5rpx;
}

.early-education-main {
  flex: 1;
  min-width: 0;
}

.early-education-label {
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: #E4F5EB;
  font-size: 25rpx;
  color: #2F7D59;
  font-weight: 600;
  line-height: 1.25;
}

.early-education-duration {
  font-size: 24rpx;
  color: #6C8F7C;
  line-height: 1.2;
}

.early-education-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.35;
  color: #1A1A1A;
  font-weight: 600;
}

.early-education-text {
  margin-top: 4rpx;
  font-size: 25rpx;
  line-height: 1.45;
  color: #333;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.early-education-reason {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  line-height: 1.4;
  color: #6C8F7C;
}

/* 时间线 */
.date-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  position: relative;
}

.date-arrow {
  font-size: 44rpx;
  color: #FF9AA2;
  padding: 8rpx 16rpx;
  font-weight: bold;
}

.date-arrow.disabled {
  color: #ddd;
}

.date-text {
  display: inline-flex;
  justify-content: center;
  min-width: 136rpx;
  font-size: 31rpx;
  font-weight: 600;
  color: #FF9AA2;
  padding: 7rpx 18rpx;
  border-radius: 24rpx;
  background: #FFF5F5;
}

.date-action-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.date-center {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.baby-line {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 14rpx;
  max-width: 100%;
  margin-bottom: 6rpx;
}

.baby-name {
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
}

.baby-age {
  flex-shrink: 0;
  font-size: 27rpx;
  color: #777;
}

.back-today {
  font-size: 29rpx;
  color: #FF9AA2;
  border: 1rpx solid #FF9AA2;
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.timeline-entry-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #FFF5F5;
  color: #FF9AA2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 2rpx rgba(255, 154, 162, 0.18);
}

.timeline-entry-btn-hover {
  background: #FFEDEE;
  transform: scale(0.96);
}

.timeline-entry-icon {
  font-size: 31rpx;
  line-height: 1;
}

.card-title {
  font-size: 35rpx;
  font-weight: 600;
}

.record-count {
  font-size: 30rpx;
  color: #999;
}

.record-filter-scroll {
  width: 100%;
  margin: -2rpx 0 14rpx;
  white-space: nowrap;
}

.record-filter-row {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding-bottom: 2rpx;
}

.record-filter-chip {
  height: 56rpx;
  min-width: 88rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #F7F8FA;
  color: #66717D;
  border: 1rpx solid #ECEFF3;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  line-height: 1;
}

.record-filter-chip.active {
  background: #FFF2F3;
  color: #E8505B;
  border-color: #FFB9C0;
  font-weight: 700;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 31rpx;
}

/* 快捷操作 */
.action-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 200rpx;
}

.action-sheet {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 30rpx;
  background: #fff;
  padding: 40rpx 50rpx;
  border-radius: 24rpx;
  max-width: 640rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.feeding-icon { background: #BBDEFB; }
.diaper-icon { background: #FFE0B2; }
.pee-icon { background: #DDF6FA; }
.poop-icon { background: #FFF0B8; }
.sleep-icon { background: #E1BEE7; }
.bath-icon { background: #D6EEF8; }
.supplement-icon { background: #C8E6C9; }
.health-icon { background: #FFCDD2; }
.growth-icon { background: #C8E6C9; }

.action-item text {
  font-size: 26rpx;
  color: #444;
}

/* 身高体重弹窗 */
.growth-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.growth-mask-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.growth-dialog {
  position: relative;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 80%;
  z-index: 1;
}

.growth-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 30rpx;
}

.growth-form-item {
  margin-bottom: 24rpx;
}

.growth-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.growth-input {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.growth-save-btn {
  margin-top: 30rpx;
  width: 100% !important;
}

.growth-delete-btn {
  margin-top: 16rpx;
  width: 100% !important;
  background: #fff !important;
  color: #FF4D4F !important;
  border: 2rpx solid #FF4D4F !important;
  border-radius: 50rpx !important;
}

/* 健康编辑标签 */
.health-tags {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.health-tag {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: #666;
}

.health-tag.active {
  background: #FFF5F5;
  color: #FF9AA2;
  border: 1rpx solid #FF9AA2;
}
