.growth-page {
  min-height: 100vh;
  background: #F8F8F8;
}

.top-panel {
  padding: 28rpx 28rpx 0;
  background: linear-gradient(180deg, #FFF5F5 0%, #F8F8F8 100%);
}

.title-row {
  display: grid;
  grid-template-columns: 128rpx 1fr 128rpx;
  align-items: center;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 64rpx;
  color: #2D2F33;
  font-size: 66rpx;
  font-weight: 300;
}

.page-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #2D2F33;
}

.add-pill {
  width: 176rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FF9AA2, #FFB7B2);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.growth-action-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
}

.growth-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  column-gap: 12rpx;
  margin-top: 18rpx;
  padding-bottom: 18rpx;
}

.growth-tab {
  position: relative;
  text-align: center;
  padding-bottom: 18rpx;
  font-size: 29rpx;
  color: #666B73;
  font-weight: 500;
  white-space: nowrap;
}

.growth-tab.active {
  color: #FF9AA2;
  font-weight: 700;
}

.growth-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: #FF9AA2;
  transform: translateX(-50%);
}

.content {
  padding: 0 24rpx 32rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-card,
.chart-card,
.empty-card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 34, 40, 0.05);
}

.record-card {
  overflow: hidden;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 26rpx 22rpx;
}

.record-date {
  font-size: 34rpx;
  color: #5F6268;
  font-weight: 700;
}

.more-btn {
  width: 64rpx;
  height: 48rpx;
  line-height: 36rpx;
  text-align: center;
  color: #B9BDC4;
  font-size: 34rpx;
  font-weight: 700;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1rpx solid #F0F0F2;
  padding: 28rpx 12rpx 32rpx;
}

.metric-item {
  min-width: 0;
  text-align: center;
}

.metric-label {
  font-size: 27rpx;
  color: #9EA2A9;
  margin-bottom: 20rpx;
}

.metric-value {
  min-height: 62rpx;
  line-height: 62rpx;
  font-size: 48rpx;
  color: #2F3237;
  font-weight: 700;
}

.metric-value.missing {
  color: #CED1D6;
}

.metric-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  min-height: 36rpx;
  margin-top: 8rpx;
  padding: 0 16rpx;
  border-radius: 18rpx;
  background: #FAFAFA;
  color: #9EA2A9;
  font-size: 26rpx;
}

.metric-pill.normal .metric-status {
  color: #24C869;
  font-weight: 700;
}

.metric-pill.low .metric-status,
.metric-pill.high .metric-status {
  color: #FF9AA2;
  font-weight: 700;
}

.empty-card {
  padding: 64rpx 30rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  color: #42454A;
  font-weight: 700;
}

.empty-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #969AA2;
}

.empty-add {
  display: inline-block;
  margin-top: 28rpx;
  padding: 16rpx 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FF9AA2, #FFB7B2);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.chart-card {
  padding: 28rpx 0 22rpx;
  overflow: hidden;
}

.chart-empty {
  padding: 54rpx 20rpx 36rpx;
  text-align: center;
}

.standard-pill {
  width: 560rpx;
  margin: 0 auto 18rpx;
  padding: 16rpx 28rpx;
  border-radius: 16rpx;
  background: #FAFAFA;
  color: #42454A;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.canvas-wrap {
  width: 100%;
  height: 720rpx;
}

.growth-canvas {
  width: 100%;
  height: 100%;
}

.chart-controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 16rpx 22rpx 0;
}

.chart-source {
  margin: 18rpx 28rpx 0;
  color: #A0A4AA;
  font-size: 24rpx;
  line-height: 1.5;
}

.chart-legend {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-wrap: wrap;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #999EA6;
}

.legend-line {
  width: 28rpx;
  height: 4rpx;
}

.legend-line.solid {
  background: #FF9AA2;
}

.legend-line.dashed {
  border-top: 2rpx dashed #FFD1DC;
}

.legend-area {
  width: 26rpx;
  height: 16rpx;
  background: rgba(255, 154, 162, 0.10);
  border-radius: 3rpx;
}

.reset-zoom {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #FF9AA2;
  padding: 8rpx 18rpx;
  border: 1rpx solid #FF9AA2;
  border-radius: 24rpx;
}

.zoom-hint {
  text-align: center;
  font-size: 22rpx;
  color: #B9BDC4;
  margin-top: 12rpx;
}
