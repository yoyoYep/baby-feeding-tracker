.mini-voice {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
  transform: scale(0.7);
}

.success-notice {
  position: fixed;
  left: 36rpx;
  right: 36rpx;
  top: calc(120rpx + env(safe-area-inset-top));
  z-index: 1200;
  min-height: 86rpx;
  padding: 18rpx 26rpx;
  border-radius: 18rpx;
  background: #1F8F4D;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 30rpx rgba(31, 143, 77, 0.28);
}

.success-mark {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-picker-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFF5F5;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.date-picker-label {
  font-size: 26rpx;
  color: #666;
}

.date-picker-value {
  font-size: 28rpx;
  color: #FF9AA2;
  font-weight: 500;
}

.record-form {
  padding-top: 10rpx;
}

.form-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.timer-section {
  text-align: center;
}

.ongoing-start-editor {
  margin-top: 8rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #f0f0f0;
  text-align: left;
}

.amount-quick {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.color-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.color-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background: #f5f5f5;
  font-size: 24rpx;
}

.color-tag.active {
  background: #FFF0F0;
  border: 1rpx solid #FF9AA2;
}

.color-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
}

.picker-input {
  color: #333;
}

.save-btn {
  margin-top: 40rpx;
  width: 100% !important;
}

.delete-btn {
  margin-top: 20rpx;
  width: 100% !important;
  background: #fff !important;
  color: #FF4D4F !important;
  border: 2rpx solid #FF4D4F !important;
  border-radius: 50rpx !important;
}

.mode-switch {
  text-align: center;
  padding: 30rpx;
}

.mode-switch text {
  font-size: 24rpx;
  color: #999;
}

.show-amount-enter {
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
