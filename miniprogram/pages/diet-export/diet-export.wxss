.diet-export-page {
  padding-bottom: 180rpx;
}

.control-card {
  padding: 28rpx;
}

.field-row {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.field-row:last-of-type {
  border-bottom: none;
}

.field-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: #59606A;
}

.field-picker,
.field-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 30rpx;
  color: #252A31;
  text-align: right;
}

.field-input {
  padding: 0;
}

.range-text {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #8A96A3;
  line-height: 1.4;
}

.record-count {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #59606A;
}

.action-row {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  margin: 0;
  padding: 0;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
}

.action-btn.primary {
  font-weight: 600;
}

.suggestion-card {
  padding: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #252A31;
}

.suggestion-row {
  display: flex;
  align-items: center;
  height: 76rpx;
  border-bottom: 1rpx solid #ECEFF3;
}

.suggestion-row:last-child {
  border-bottom: none;
}

.suggestion-index {
  width: 46rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #59606A;
}

.suggestion-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  font-size: 27rpx;
  color: #252A31;
}

.preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 4rpx 16rpx;
}

.sheet-tabs {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.sheet-tab-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 2rpx;
}

.sheet-tab {
  min-width: 112rpx;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #FFFFFF;
  border: 1rpx solid #E6EAF0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.sheet-tab.active {
  border-color: #FF9AA2;
  background: #FFF5F6;
}

.sheet-tab-date {
  font-size: 25rpx;
  font-weight: 700;
  color: #252A31;
  line-height: 1.1;
}

.sheet-tab-count {
  margin-top: 5rpx;
  font-size: 20rpx;
  color: #8A96A3;
  line-height: 1;
}

.sheet-tab.active .sheet-tab-date {
  color: #E86D78;
}

.preview-shell {
  position: relative;
  min-height: 760rpx;
  border-radius: 8rpx;
  background: #ECEFF3;
  padding: 18rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

.preview-canvas {
  display: block;
  border-radius: 4rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(31, 34, 40, 0.10);
}

.preview-empty {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 18rpx;
  bottom: 18rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #9AA2AD;
}
